# Radio Registry API - Environment Configuration
# Copy this file to .env and update values for your deployment

# =============================================================================
# REQUIRED - Security (change these before deploying!)
# =============================================================================

# Admin panel password
ADMIN_PASSWORD=changeme

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SECRET_KEY=super-secret-key-change-me

# =============================================================================
# REQUIRED - Service URLs (set these to your actual addresses)
# =============================================================================

# Your Tor hidden service address
TOR_ONION_URL=http://your-onion-address.onion

# Your I2P address (optional, leave empty if not using I2P)
I2P_URL=http://your-i2p-address.b32.i2p

# Clearnet URL (optional, leave empty if not using clearnet)
# CLEARNET_URL=https://your-domain.com

# =============================================================================
# OPTIONAL - Notifications
# =============================================================================

# ntfy.sh topic for push notifications (leave empty to disable)
NTFY_TOPIC=

# =============================================================================
# OPTIONAL - Server Settings
# =============================================================================

# Server bind address and port
HOST=127.0.0.1
PORT=8080

# =============================================================================
# OPTIONAL - Proxy Settings (for validating Tor/I2P streams)
# =============================================================================

# Tor SOCKS5 proxy
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050

# I2P HTTP proxy
I2P_HTTP_PROXY=http://127.0.0.1:4444

# =============================================================================
# OPTIONAL - CORS Origins (comma-separated list)
# =============================================================================

# Allowed origins for API access
# CORS_ORIGINS=http://localhost:8000,http://localhost:3000,https://yourusername.github.io
